{
	"$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@tarquinen/opencode-dcp@latest"
  ],
	"disabled_providers": ["opencode"],
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp"
		}
	},
	"lsp": {
		"ty": {
			"command": ["ty", "server"],
			"extensions": [".py", ".pyi"]
		},
		"ruff": {
			"command": ["ruff", "server"],
			"extensions": [".py", ".pyi"]
		},
		"pyright": {
			"disabled": true
		},
		"marksman": {
			"command": ["marksman", "server"],
			"extensions": [".md", ".mdx"]
		},
		"gopls": {
			"disabled": true
		},
		"golangci-lint-langserver": {
			"command": ["golangci-lint-langserver"],
			"extensions": [".go"],
			"initialization": {
				"command": [
					"golangci-lint",
					"run",
					"--output.json.path",
					"stdout",
					"--show-stats=false",
					"--issues-exit-code=1"
				]
			}
		}
	},
	"permission": {
		"bash": {
			"*": "allow",
			"rm -rf *": "deny",
			"rm -fr *": "deny",
			"sudo *": "deny",
			"mkfs *": "deny",
			"dd *": "deny",
			"curl *|bash*": "deny",
			"wget *|bash*": "deny",
			"git *": "ask",
			"git commit": "deny",
			"git push": "deny",
			"git push --force*": "deny",
			"git push *--force*": "deny",
			"git reset --hard*": "deny"
		},
		"edit": {
			"*": "allow",
			"~/.bashrc": "deny",
			"~/.zshrc": "deny",
			"~/.ssh/**": "deny"
		},
		"read": {
			"*": "allow",
			"~/.ssh/**": "deny",
			"~/.gnupg/**": "deny",
			"~/.aws/**": "deny",
			"~/.azure/**": "deny",
			"~/.config/gh/**": "deny",
			"~/.git-credentials": "deny",
			"~/.docker/config.json": "deny",
			"~/.kube/**": "deny",
			"~/.npmrc": "deny",
			"~/.npm/**": "deny",
			"~/.pypirc": "deny",
			"~/.gem/credentials": "deny",
			"~/Library/Keychains/**": "deny",
			"~/Library/Application Support/**/metamask*/**": "deny",
			"~/Library/Application Support/**/electrum*/**": "deny",
			"~/Library/Application Support/**/exodus*/**": "deny",
			"~/Library/Application Support/**/phantom*/**": "deny",
			"~/Library/Application Support/**/solflare*/**": "deny"
		}
	}
}
