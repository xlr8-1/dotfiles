#!/bin/bash
{{ if eq .chezmoi.os "linux" -}}
# external: {{ include ".chezmoiexternal.toml.tmpl" | sha256sum }}

fc-cache -fv
mise install
{{ end -}}


{{ if eq .distro "omarchy" -}}
set -e

echo "🔄 Reloading configurations..."
# ==============================================================================
# Reload Services
# ==============================================================================

# Reload Hyprland configuration
omarchy-restart-hyprctl

# Restart Quickshell shell (bar, notifications, OSD, lock screen)
omarchy restart shell

# Reload systemd user daemon
if systemctl --user list-unit-files | grep -q "omarchy-battery-monitor.service"; then
    echo "  ↻ Reloading systemd user daemon..."
    systemctl --user daemon-reload
    echo "    ✓ systemd daemon reloaded"
fi

echo "✅ Configuration reload complete!"
{{ end -}}
